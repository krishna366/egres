# Auto-generated test root assembled by build.zig from collectTestFiles().
.test_root.zig

# Zig build outputs. zig-pkg/ is where Zig 0.16 unpacks the deps pinned
# in build.zig.zon (global cache keeps only the tarballs); regenerated by
# `zig build`.
.zig-cache/
zig-out/
zig-pkg/

# Native dependencies built by pinned bootstrap scripts.
.deps/

# Claude Code's per-project settings and session state.
.claude/

*.log

# timeout-stress harness scratch file (cwd-relative; normally unlinked on exit,
# but left behind if the harness panics on a detected bug).
timeout-stress.io

patches/

# Python bytecode and the monitor env file each run rewrites.
__pycache__/
benchmarks/monitor/.env
benchmarks/run/local.toml
