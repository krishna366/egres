.{
    .name = .egres,
    .version = "0.0.0",
    .fingerprint = 0xb7f2c3c0a4a0fbdc,
    .paths = .{""},
    // Zig-package deps are pinned to upstream commits so a fresh clone
    // builds with only `zig build` (they land in the global zig cache).
    // To bump one: `zig fetch --save=<name> <github-archive-tarball-url>`.
    // Native deps (mimalloc/jemalloc) are bootstrapped by build.zig from
    // pinned tarballs, see scripts/bootstrap-*.sh.
    .dependencies = .{
        .zio = .{
            .url = "https://github.com/manishrjain/zio/archive/faf34a89913e45c7ca66587e940b6a56faf32fe2.tar.gz",
            .hash = "zio-0.12.1-xHbVVPJmHAAM5Emlg-r8aS9tBp1vXFc0CpVQEuSaZVlY",
        },
        .metrics = .{
            .url = "https://github.com/karlseguin/metrics.zig/archive/1621f82e7ecf2b3dddf5730bf52761af354a7080.tar.gz",
            .hash = "metrics-0.0.0-W7G4eJOgAQDBacPAeqGCaY8gV7zuddUQyikGNq7nDPds",
        },
        // Our fork's `egres` branch: upstream 9ce8e8e plus one kqueue
        // fix the macOS build needs (the commit message has the why).
        .xev = .{
            .url = "https://github.com/manishrjain/libxev/archive/a17c233be025cfefbc5f25f84872663cdd2ec9e9.tar.gz",
            .hash = "libxev-0.0.0-86vtcxEUFADjhjYZ-vs_yVMJPAwUhhDchs_NfLl0rnqh",
        },
        .zroar = .{
            .url = "https://github.com/manishrjain/zroar/archive/refs/tags/0.2608.1.tar.gz",
            .hash = "zroar-0.2608.1-RSTcJaHKBQAweqlkbh8mJyJyOCocWn7bxX7vtFahnVSA",
        },
    },
}
